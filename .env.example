# .env.example  —  Copia este archivo como .env y rellena los valores reales.
# El archivo .env está en .gitignore y NUNCA debe subirse al repositorio.

# ── ngrok ─────────────────────────────────────────────────────────────────────
# Obtén tu token en: https://dashboard.ngrok.com/get-started/your-authtoken
# Configúralo con:   ngrok config add-authtoken TU_TOKEN
# (se guarda en AppData/Local/ngrok/ngrok.yml, fuera del repo)
NGROK_AUTHTOKEN=

# ── Servidor Flask ────────────────────────────────────────────────────────────
FLASK_PORT=5000
FLASK_HOST=0.0.0.0

# ── Arduino / Hardware (opcional) ─────────────────────────────────────────────
SERIAL_PORT=COM3
ENABLE_HARDWARE=false
